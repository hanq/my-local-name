<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="my-local-name.exe"
        Arguments=""
        InstallLocation="C:\Program Files\hanq\My Local Name">
    </Installer>
    <PackageInformation
        PackageName="My Local Name"
        PackageDisplayName="My Local Name"
        PublisherName="CN=hanq"
        PublisherDisplayName="hanq"
        Version="0.1.0.0"
        PackageDescription="Advertise a custom .local hostname on your LAN over mDNS">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="cn.hanq.mylocalname"
                Description="Advertise a custom .local hostname on your LAN over mDNS"
                DisplayName="My Local Name"
                ExecutableName="my-local-name.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>My Local Name</DisplayName>
            <PublisherDisplayName>hanq</PublisherDisplayName>
            <Description>Advertise a custom .local hostname on your LAN over mDNS</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="my-local-name.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
